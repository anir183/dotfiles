binds {
    Ctrl+Alt+Delete repeat=false hotkey-overlay-title="task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+Shift+Escape repeat=false hotkey-overlay-title="task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+Shift+R repeat=false hotkey-overlay-title="rename workspace" { spawn "dms" "ipc" "call" "workspace-rename" "open"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "decrement" "1"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "increment" "1"; }
    Mod+Alt+L repeat=false hotkey-overlay-title="lock screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Comma repeat=false hotkey-overlay-title="settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+Ctrl+N repeat=false hotkey-overlay-title="toggle nightlight" { spawn "dms" "ipc" "call" "night" "toggle"; }
    Mod+M repeat=false hotkey-overlay-title="task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Mod+N repeat=false hotkey-overlay-title="notification center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+C repeat=false hotkey-overlay-title="color picker" { spawn "dms" "color" "pick" "-a"; }
    Mod+Shift+N repeat=false hotkey-overlay-title="notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="create window rule" { spawn "dms" "ipc" "call" "window-rules" "toggle"; }
    Mod+Space repeat=false hotkey-overlay-title="app launcher: toggle" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+V repeat=false hotkey-overlay-title="clipboard manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Y repeat=false hotkey-overlay-title="browse wallpapers" { spawn "dms" "ipc" "call" "dankdash" "wallpaper"; }
    Mod+X hotkey-overlay-title="power menu: toggle" repeat=false { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "1"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "1"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "1" ""; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "1" ""; }
    Mod+0 { focus-workspace 1; }
    Mod+1 { focus-workspace 2; }
    Mod+2 { focus-workspace 3; }
    Mod+3 { focus-workspace 4; }
    Mod+4 { focus-workspace 5; }
    Mod+5 { focus-workspace 6; }
    Mod+6 { focus-workspace 7; }
    Mod+7 { focus-workspace 8; }
    Mod+8 { focus-workspace 9; }
    Mod+9 { focus-workspace 10; }
    Mod+Alt+Shift+H repeat=false { move-workspace-to-monitor-left; }
    Mod+Alt+Shift+L repeat=false { move-workspace-to-monitor-right; }
    Mod+Ctrl+Down repeat=false { move-column-to-workspace-down; }
    Mod+Ctrl+I repeat=false { move-column-to-workspace-up; }
    Mod+Ctrl+U repeat=false { move-column-to-workspace-down; }
    Mod+Ctrl+Up repeat=false { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+I repeat=false { focus-workspace-up; }
    Mod+Page_Down repeat=false { focus-workspace-down; }
    Mod+Page_Up repeat=false { focus-workspace-up; }
    Mod+Shift+0 repeat=false { move-column-to-workspace 1; }
    Mod+Shift+1 repeat=false { move-column-to-workspace 2; }
    Mod+Shift+2 repeat=false { move-column-to-workspace 3; }
    Mod+Shift+3 repeat=false { move-column-to-workspace 4; }
    Mod+Shift+4 repeat=false { move-column-to-workspace 5; }
    Mod+Shift+5 repeat=false { move-column-to-workspace 6; }
    Mod+Shift+6 repeat=false { move-column-to-workspace 7; }
    Mod+Shift+7 repeat=false { move-column-to-workspace 8; }
    Mod+Shift+8 repeat=false { move-column-to-workspace 9; }
    Mod+Shift+9 repeat=false { move-column-to-workspace 10; }
    Mod+Shift+I repeat=false { move-workspace-up; }
    Mod+Shift+Page_Down repeat=false { move-workspace-down; }
    Mod+Shift+Page_Up repeat=false { move-workspace-up; }
    Mod+Shift+U repeat=false { move-workspace-down; }
    Mod+U repeat=false { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Alt+Print repeat=false { screenshot-window; }
    Alt+XF86Launch1 repeat=false { screenshot-window; }
    Mod+BracketLeft repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false { consume-or-expel-window-right; }
    Mod+C repeat=false { center-column; }
    Mod+Ctrl+C repeat=false { center-visible-columns; }
    Mod+Ctrl+End repeat=false { move-column-to-last; }
    Mod+Ctrl+F repeat=false { expand-column-to-available-width; }
    Mod+Ctrl+H repeat=false { focus-monitor-left; }
    Mod+Ctrl+Home repeat=false { move-column-to-first; }
    Mod+Ctrl+J repeat=false { focus-monitor-down; }
    Mod+Ctrl+K repeat=false { focus-monitor-up; }
    Mod+Ctrl+L repeat=false { focus-monitor-right; }
    Mod+Ctrl+Left repeat=false { focus-monitor-left; }
    Mod+Ctrl+R repeat=false { reset-window-height; }
    Mod+Ctrl+Right repeat=false { focus-monitor-right; }
    Mod+Ctrl+Shift+Return repeat=false hotkey-overlay-title="open private browser" { spawn "flatpak" "run" "app.zen_browser.zen" "--private-window"; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Down repeat=false { focus-window-down; }
    Mod+End repeat=false { focus-column-last; }
    Mod+Equal repeat=false { set-column-width "+10%"; }
    Mod+F repeat=false { maximize-column; }
    Mod+H repeat=false { focus-column-left; }
    Mod+Home repeat=false { focus-column-first; }
    Mod+J repeat=false { focus-window-down; }
    Mod+K repeat=false { focus-window-up; }
    Mod+L repeat=false { focus-column-right; }
    Mod+Left repeat=false { focus-column-left; }
    Mod+Minus repeat=false { set-column-width "-10%"; }
    Mod+Period repeat=false { expel-window-from-column; }
    Mod+R repeat=false { switch-preset-column-width; }
    Mod+Right repeat=false { focus-column-right; }
    Mod+Shift+Ctrl+Down repeat=false { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H repeat=false { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J repeat=false { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K repeat=false { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L repeat=false { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left repeat=false { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right repeat=false { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up repeat=false { move-column-to-monitor-up; }
    Mod+Shift+Down repeat=false { move-window-down; }
    Mod+Shift+Equal repeat=false { set-window-height "+10%"; }
    Mod+Shift+Escape repeat=false { spawn "sh" "-c" "niri msg -j focused-window | jq > /tmp/niri-focused-win && ghostty -e nvim /tmp/niri-focused-win"; }
    Mod+Shift+F repeat=false { fullscreen-window; }
    Mod+Shift+H repeat=false { move-column-left; }
    Mod+Shift+J repeat=false { move-window-down; }
    Mod+Shift+K repeat=false { move-window-up; }
    Mod+Shift+L repeat=false { move-column-right; }
    Mod+Shift+Left repeat=false { move-column-left; }
    Mod+Shift+Minus repeat=false { set-window-height "-10%"; }
    Mod+Shift+Q repeat=false { close-window; }
    Mod+Shift+R repeat=false { switch-preset-window-height; }
    Mod+Shift+Right repeat=false { move-column-right; }
    Mod+Shift+S repeat=false { screenshot-window; }
    Mod+Shift+T repeat=false { toggle-window-floating; }
    Mod+Shift+Up repeat=false { move-window-up; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Up repeat=false { focus-window-up; }
    Mod+W repeat=false { toggle-column-tabbed-display; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+Shift+P repeat=false { power-off-monitors; }
    Ctrl+Print repeat=false { screenshot-screen; }
    Ctrl+XF86Launch1 repeat=false { screenshot-screen; }
    Mod+Ctrl+S repeat=false { screenshot-screen; }
    Mod+S repeat=false { screenshot; }
    Print repeat=false { screenshot; }
    XF86Launch1 repeat=false { screenshot; }
    Mod+Shift+E repeat=false { quit; }
    Mod+Ctrl+Shift+C repeat=false hotkey-overlay-title="eye dropper" { spawn "flatpak" "run" "com.github.finefindus.eyedropper"; }
    Mod+E repeat=false hotkey-overlay-title="open file explorer" { spawn "nautilus"; }
    Mod+Return hotkey-overlay-title="open terminal" repeat=false { spawn "ghostty"; }
    Mod+Ctrl+Return hotkey-overlay-title="open mux sessions" { spawn "dms" "ipc" "tmux" "open"; }
    Mod+Shift+M hotkey-overlay-title="mission center" repeat=false { spawn "flatpak" "run" "io.missioncenter.MissionCenter"; }
    Mod+Shift+Return hotkey-overlay-title="open browser" repeat=false { spawn "flatpak" "run" "app.zen_browser.zen"; }
    Mod+Ctrl+Shift+S repeat=false hotkey-overlay-title="gradia screenshot" { spawn "sh" "-c" "flatpak run be.alexandervanhee.gradia"; }
    Mod+Shift+Comma repeat=false hotkey-overlay-title="emoji picker" { spawn "flatpak" "run" "it.mijorus.smile"; }
    Mod+D repeat=false { toggle-overview; }
    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }
    Mod+Tab repeat=false { toggle-overview; }
}
