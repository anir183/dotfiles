#!/usr/bin/env python3

from __future__ import annotations

import os
import secrets
import shlex
import shutil
import string
import subprocess
import sys
import tempfile
from pathlib import Path


APP_NAME = "remember"
EXEC_DIR = Path.cwd()
HOME = Path.home()

XDG_DATA_HOME = Path(
    os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share")
).expanduser()

DEFAULT_STORE_DIR = Path(
    os.environ.get(
        "REMEMBER_STORE_DIR",
        XDG_DATA_HOME / APP_NAME,
    )
).expanduser()

REMEMBER_STORE_DIR = DEFAULT_STORE_DIR
STORAGE_FILE = DEFAULT_STORE_DIR / "store_default"


# ============================================================
# Utilities
# ============================================================

def command_exists(command: str) -> bool:
    return shutil.which(command) is not None


def run_command(command: list[str]) -> int:
    try:
        return subprocess.run(command).returncode
    except OSError as exc:
        print(f"could not run {' '.join(command)}: {exc}", file=sys.stderr)
        return 1


def read_store() -> list[str]:
    try:
        return [
            line
            for line in STORAGE_FILE.read_text(encoding="utf-8").splitlines()
            if line
        ]
    except FileNotFoundError:
        return []
    except OSError as exc:
        print(f"could not read store: {exc}", file=sys.stderr)
        return []


def write_store(entries: list[str]) -> bool:
    """Atomically replace the store to avoid corruption on interruption."""
    STORAGE_FILE.parent.mkdir(parents=True, exist_ok=True)

    content = "\n".join(entries)
    if entries:
        content += "\n"

    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=STORAGE_FILE.parent,
            prefix=f".{STORAGE_FILE.name}.",
            delete=False,
        ) as tmp:
            tmp.write(content)
            tmp.flush()
            os.fsync(tmp.fileno())
            temp_path = Path(tmp.name)

        os.replace(temp_path, STORAGE_FILE)
        return True

    except OSError as exc:
        print(f"could not write store: {exc}", file=sys.stderr)

        try:
            temp_path.unlink(missing_ok=True)
        except UnboundLocalError:
            pass

        return False


def ensure_storage() -> bool:
    try:
        if not REMEMBER_STORE_DIR.is_dir():
            REMEMBER_STORE_DIR.mkdir(parents=True, exist_ok=True)
            print(f"created storage directory at: {REMEMBER_STORE_DIR}")

        if not STORAGE_FILE.exists():
            STORAGE_FILE.touch()
            print(f"created storage file at: {STORAGE_FILE}")

        if not STORAGE_FILE.is_file():
            print(f"store is not a regular file: {STORAGE_FILE}", file=sys.stderr)
            return False

        return True

    except OSError as exc:
        print(
            f"could not initiate storage at {STORAGE_FILE}: {exc}",
            file=sys.stderr,
        )
        return False


def backup_store() -> bool:
    backup = Path(f"{STORAGE_FILE}.bak")

    try:
        shutil.copy2(STORAGE_FILE, backup)
        return True
    except OSError as exc:
        print(f"could not create backup: {exc}", file=sys.stderr)
        return False


# ============================================================
# fzf
# ============================================================

def fuzzy_select(entries: list[str], prompt: str = "remember> ") -> str | None:
    if not entries:
        return None

    if not command_exists("fzf"):
        print("fzf is required", file=sys.stderr)
        return None

    try:
        result = subprocess.run(
            ["fzf", "--prompt", prompt],
            input="\n".join(entries),
            text=True,
            capture_output=True,
        )
    except OSError as exc:
        print(f"could not start fzf: {exc}", file=sys.stderr)
        return None

    if result.returncode != 0:
        return None

    selected = result.stdout.rstrip("\n")
    return selected or None


# ============================================================
# Help
# ============================================================

def help_menu() -> None:
    print(f"""\
remember <action> [opt]

bookmarking directories for fast switching.

    NOTE:
    * run `remember init fish | source` for fish shell integration
    * fzf is required for fuzzy directory selection
    * REMEMBER_STORE_DIR changes the default store directory
      (default: {DEFAULT_STORE_DIR})
    * create a .remrc file in a directory to use a custom store
      for that directory and all of its subdirectories
    * .remrc must contain the absolute path to a store file

AVAILABLE ACTIONS:

    <none>
            same as: remember goto

    go | goto
            open fuzzy matcher to goto a stored directory

    d | def | default <action> [args...]
            run an action using the default store, ignoring .remrc

    a | add | new
            add current directory to store

    c | rc | create | create-rc
            create a .remrc file in current directory

    rm | remove | del | delete
            remove current directory from store

    rmf | rm-fuzz | remove-fuzz
            fuzzy-select a directory to remove

    rma | rmx | remove-all | nuke
            remove all stored directories

    e | ed | edit
            open store file in editor

    1 | 2 | 3 | ...
            goto directory at given index

    l | ls | ll | list
            list stored directories

    init fish
            output fish shell integration

    h | help | --help
            show this message

EXAMPLES:

    remember
    remember add
    remember remove
    remember 1
    remember goto
    remember list
    remember init fish | source
""")


# ============================================================
# .remrc
# ============================================================

def find_remrc() -> Path | None:
    path = EXEC_DIR

    while True:
        rc_file = path / ".remrc"

        if rc_file.is_file():
            return rc_file

        if path == path.parent:
            return None

        path = path.parent


def create_rc_file() -> int:
    rc_file = EXEC_DIR / ".remrc"

    if rc_file.exists():
        print(f"rc file already exists at: {rc_file}")
        return 0

    try:
        store_path = input("path (<enter> for xdg data): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 1

    if not store_path:
        random_name = "".join(
            secrets.choice(string.ascii_lowercase + string.digits)
            for _ in range(7)
        )
        store_path = str(
            XDG_DATA_HOME / APP_NAME / f"store_{random_name}"
        )

    store_path = Path(store_path).expanduser()

    if not store_path.is_absolute():
        print("store path must be absolute", file=sys.stderr)
        return 1

    try:
        rc_file.write_text(
            f"{store_path}\n",
            encoding="utf-8",
        )
    except OSError as exc:
        print(f"could not create rc file: {exc}", file=sys.stderr)
        return 1

    print(f"created rc file at: {rc_file}")
    return 0


def use_remrc() -> None:
    global REMEMBER_STORE_DIR
    global STORAGE_FILE

    rc_file = find_remrc()

    if rc_file is None:
        return

    try:
        lines = rc_file.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        print(f"could not read rc file: {exc}", file=sys.stderr)
        return

    if not lines:
        return

    raw_path = lines[0].strip()

    if not raw_path:
        return

    store_file = Path(raw_path).expanduser()

    if not store_file.is_absolute():
        print(f"invalid path in rc file: {rc_file}", file=sys.stderr)
        print(raw_path, file=sys.stderr)
        print(
            f"path has to be absolute and a sub-directory of {HOME}",
            file=sys.stderr,
        )
        return

    try:
        store_file = store_file.resolve(strict=False)
        store_file.relative_to(HOME.resolve())
    except ValueError:
        print(f"invalid path in rc file: {rc_file}", file=sys.stderr)
        print(raw_path, file=sys.stderr)
        print(
            f"path has to be absolute and a sub-directory of {HOME}",
            file=sys.stderr,
        )
        return

    REMEMBER_STORE_DIR = store_file.parent
    STORAGE_FILE = store_file

    print(f"custom store file from remrc: {STORAGE_FILE}")


# ============================================================
# Store operations
# ============================================================

def add_to_store() -> int:
    current = str(EXEC_DIR.resolve())
    entries = read_store()

    if current in entries:
        print("this directory is already in the store")
        return 0

    entries.append(current)

    if not write_store(entries):
        return 1

    print(f"added {current} to the store")
    return 0


def remove_pwd_from_store() -> int:
    current = str(EXEC_DIR.resolve())
    entries = read_store()

    if current not in entries:
        print(f"dir {current} not found in store")
        return 1

    if not backup_store():
        return 1

    entries.remove(current)

    if not write_store(entries):
        return 1

    print(f"removed {current} from the store")
    return 0


def remove_from_store() -> int:
    entries = read_store()

    selected = fuzzy_select(entries, "remove> ")

    if selected is None:
        return 0

    if selected not in entries:
        print(f"dir {selected} not found in store")
        return 1

    if not backup_store():
        return 1

    entries.remove(selected)

    return 0 if write_store(entries) else 1


def remove_all_from_store() -> int:
    try:
        choice = input("<enter> or <y> to confirm: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 1

    if not choice or choice.lower().startswith("y"):
        if not backup_store():
            return 1

        if not write_store([]):
            return 1

        print("emptied store")
        return 0

    print("aborting removal")
    return 0


# ============================================================
# Editor
# ============================================================

def open_in_editor() -> int:
    editor = os.environ.get("EDITOR", "").strip()

    if editor:
        try:
            command = shlex.split(editor)
        except ValueError as exc:
            print(f"invalid EDITOR value: {exc}", file=sys.stderr)
            return 1

        if not command:
            print("invalid EDITOR value", file=sys.stderr)
            return 1

        return run_command(command + [str(STORAGE_FILE)])

    for name in ("nvim", "code", "vim", "vi", "nano"):
        path = shutil.which(name)

        if path:
            return run_command([path, str(STORAGE_FILE)])

    print("no supported editor")
    return 1


# ============================================================
# Navigation
# ============================================================

def resolve_goto_index(index: int) -> str | None:
    entries = read_store()

    if index < 1 or index > len(entries):
        return None

    # Blank lines aren't normally written, but don't let them count.
    valid_entries = [entry for entry in entries if entry.strip()]

    if index > len(valid_entries):
        return None

    return valid_entries[index - 1]


def resolve_goto_fuzzy() -> str | None:
    entries = [
        entry
        for entry in read_store()
        if entry.strip()
    ]

    if not entries:
        return None

    return fuzzy_select(entries)


def goto_dir() -> int:
    entries = [
        entry
        for entry in read_store()
        if entry.strip()
    ]

    if not entries:
        print("no directories in the store")
        return 1

    selected = fuzzy_select(entries)

    if selected is None:
        return 0

    print(selected)
    return 0


def goto_index(index: str) -> int:
    try:
        number = int(index)
    except ValueError:
        print("no dir stored at index")
        return 1

    target = resolve_goto_index(number)

    if target is None:
        print("no dir stored at index")
        return 1

    print(target)
    return 0


# ============================================================
# Listing
# ============================================================

def list_store() -> int:
    if command_exists("bat"):
        return run_command(["bat", str(STORAGE_FILE)])

    try:
        sys.stdout.write(
            STORAGE_FILE.read_text(encoding="utf-8")
        )
    except OSError as exc:
        print(f"could not read store: {exc}", file=sys.stderr)
        return 1

    return 0


# ============================================================
# Fish integration
# ============================================================

def init_fish() -> int:
    """
    Generate the fish function that allows remember to change the
    parent shell's working directory.
    """
    script = str(Path(__file__).resolve())

    print(f'''\
function remember
    set -l action $argv[1]

    switch "$action"
        case "" goto go
            set -l target ("{script}" __goto $argv[2..-1])

            if test $status -eq 0; and test -n "$target"; and test -d "$target"
                cd -- "$target"
            end

        case '*'
            "{script}" $argv
    end
end
''')

    return 0


# ============================================================
# Main
# ============================================================

def main() -> int:
    global REMEMBER_STORE_DIR
    global STORAGE_FILE

    args = sys.argv[1:]

    # --------------------------------------------------------
    # Shell integration
    # --------------------------------------------------------

    if args and args[0] == "init":
        if len(args) == 2 and args[1] == "fish":
            return init_fish()

        print("usage: remember init fish", file=sys.stderr)
        return 1

    # --------------------------------------------------------
    # Internal navigation command
    #
    # Used exclusively by the generated shell integration.
    # It MUST print only the target path.
    # --------------------------------------------------------

    if args and args[0] == "__goto":
        goto_args = args[1:]

        # Internal command uses the same .remrc behavior as normal goto.
        use_remrc()

        if not ensure_storage():
            return 1

        if not goto_args:
            target = resolve_goto_fuzzy()
        elif len(goto_args) == 1 and goto_args[0].isdigit():
            target = resolve_goto_index(int(goto_args[0]))
        elif len(goto_args) == 1 and goto_args[0] in {"goto", "go"}:
            target = resolve_goto_fuzzy()
        else:
            return 1

        if target is None:
            return 1

        print(target)
        return 0

    # --------------------------------------------------------
    # Argument validation
    # --------------------------------------------------------

    if len(args) > 2:
        print("too many arguments")
        print("check docs with: remember help")
        return 1

    action = args[0] if args else ""
    argument = args[1] if len(args) == 2 else ""

    # --------------------------------------------------------
    # "default" bypasses .remrc
    # --------------------------------------------------------

    if action in {"d", "def", "default"}:
        action = argument
    else:
        use_remrc()

    # --------------------------------------------------------
    # Store initialization
    # --------------------------------------------------------

    if not ensure_storage():
        return 1

    # --------------------------------------------------------
    # Dispatch
    # --------------------------------------------------------

    if action in {"", "g", "go", "goto"}:
        return goto_dir()

    if action in {"l", "ls", "ll", "list"}:
        return list_store()

    if action in {"c", "cr", "create", "rc", "create-rc"}:
        return create_rc_file()

    if action in {"a", "add", "new"}:
        return add_to_store()

    if action in {"r", "rm", "remove", "del", "delete"}:
        return remove_pwd_from_store()

    if action in {"rmf", "rm-fuzz", "remove-fuzz"}:
        return remove_from_store()

    if action in {"rma", "rmx", "remove-all", "nuke"}:
        return remove_all_from_store()

    if action in {"e", "ed", "edit"}:
        return open_in_editor()

    if action.isdigit():
        return goto_index(action)

    if action in {"h", "help", "--help"}:
        help_menu()
        return 0

    print("invalid <action> argument")
    print("check docs with: remember help")
    return 1


if __name__ == "__main__":
    sys.exit(main())
